# Copie para .env.local (desenvolvimento) e preencha.
# Na Vercel: Project → Settings → Environment Variables (mesmos nomes).
# NUNCA coloque valores reais deste arquivo no repositório.

# --- Endereço do sistema -----------------------------------------------------
# Local: http://localhost:3000 · Produção: https://fideliza.bicuira.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys) ----------------------------------
# Endereço do projeto. Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública ("publishable", começa com sb_publishable_). Pode ir para o navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave SECRETA ("secret", começa com sb_secret_). Só no servidor. Ignora as regras de acesso.
SUPABASE_SECRET_KEY=

# --- Segurança ---------------------------------------------------------------
# Texto aleatório longo, usado para gravar IPs com hash (auditoria e limite do formulário).
# Gere com: openssl rand -hex 32
SEGREDO_HASH=

# --- Apple Wallet (opcional; passo a passo em docs/SETUP-WALLET.md) ----------
# Sem estas variáveis, o botão mostra "Wallet ainda não configurado".
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
# Arquivos PEM convertidos em base64 (uma linha só)
APPLE_PASS_CERT_BASE64=
APPLE_PASS_KEY_BASE64=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT_BASE64=

# --- Google Wallet (opcional; passo a passo em docs/SETUP-WALLET.md) ---------
GOOGLE_WALLET_ISSUER_ID=
# Arquivo JSON da conta de serviço convertido em base64 (uma linha só)
GOOGLE_WALLET_SERVICE_ACCOUNT_BASE64=

# --- Tarefas agendadas ---------------------------------------------------------
# Texto aleatório longo. A Vercel envia automaticamente nos crons; use o mesmo no pg_cron (README).
# Gere com: openssl rand -hex 32
CRON_SECRET=

# --- Cartão no Wallet ----------------------------------------------------------
# false (ou vazio): o cartão é só a página web (piloto). true: mostra os botões de Apple/Google Wallet.
WALLET_ATIVO=false
